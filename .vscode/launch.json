{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug FastAPI",
            "type": "debugpy",
            "request": "launch",

            "module": "uvicorn",

            "args": [
                "python.app:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],

            "cwd": "${workspaceFolder}",

            "console": "integratedTerminal"
        },

        {
            "name": "Debug EngineTests (C++)",
            "type": "cppvsdbg",
            "request": "launch",

            "program": "${workspaceFolder}\\build_pybind\\Debug\\magnetics_engine_tests.exe",

            "cwd": "${workspaceFolder}",

            "stopAtEntry": false
        }
    ]
}